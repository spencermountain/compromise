{
  "name": "compromise",
  "version": "14.17.0",
  "description": "modest natural language processing",
  "license": "MIT",
  "repository": "github:spencermountain/compromise",
  "homepage": "https://compromise.cool",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./types/three.d.ts",
        "default": "./src/three.js"
      },
      "require": {
        "types": "./types/three.d.cts",
        "default": "./builds/three/compromise-three.cjs"
      }
    },
    "./tokenize": {
      "import": {
        "types": "./types/one.d.ts",
        "default": "./src/one.js"
      },
      "require": {
        "types": "./types/one.d.cts",
        "default": "./builds/one/compromise-one.cjs"
      }
    },
    "./one": {
      "import": {
        "types": "./types/one.d.ts",
        "default": "./src/one.js"
      },
      "require": {
        "types": "./types/one.d.cts",
        "default": "./builds/one/compromise-one.cjs"
      }
    },
    "./two": {
      "import": {
        "types": "./types/two.d.ts",
        "default": "./src/two.js"
      },
      "require": {
        "types": "./types/two.d.cts",
        "default": "./builds/two/compromise-two.cjs"
      }
    },
    "./three": {
      "import": {
        "types": "./types/three.d.ts",
        "default": "./src/three.js"
      },
      "require": {
        "types": "./types/three.d.cts",
        "default": "./builds/three/compromise-three.cjs"
      }
    },
    "./misc": {
      "import": {
        "types": "./types/misc.d.ts"
      },
      "require": {
        "types": "./types/misc.d.cts"
      }
    },
    "./view/*": {
      "import": {
        "types": "./types/view/*.d.ts"
      },
      "require": {
        "types": "./types/view/*.d.cts"
      }
    }
  },
  "main": "./src/three.js",
  "module": "./src/three.js",
  "types": "./types/three.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=12.0.0"
  },
  "scripts": {
    "build": "node ./scripts/version.js && node ./scripts/docs.js && rollup -c --silent",
    "watch": "node --watch ./scratch.js",
    "pack": "node ./scripts/pack.js",
    "version": "node ./scripts/version.js",
    "test": "tape \"./tests/**/*.test.js\" | tap-dancer",
    "testb": "tape \"./scripts/test/smoke.test.js\" | tap-dancer && cross-env TESTENV=prod tape \"./tests/**/*.test.js\" | tap-dancer",
    "test:one": "tape \"./tests/one/**/*.test.js\" | tap-dancer",
    "test:two": "tape \"./tests/two/**/*.test.js\" | tap-dancer",
    "test:three": "tape \"./tests/three/**/*.test.js\" | tap-dancer",
    "test:types": "tsc --project tsconfig.json && tsc --project tsconfig.json --module Node16 --moduleResolution Node16",
    "test:filesize": "node ./scripts/filesize.js",
    "test:smoke": "tape \"./scripts/test/smoke.test.js\" | tap-dancer",
    "test:plugins": "pnpm --filter \"./plugins/*\" run test",
    "stress": "node scripts/test/stress.js",
    "debug": "node ./scripts/debug.js",
    "match": "node ./scripts/match.js",
    "bench": "node ./scripts/bench/index.js",
    "lint": "eslint src",
    "docs": "node ./scripts/docs.js",
    "plugins:build": "pnpm --filter \"./plugins/*\" run build",
    "test:plugins:build": "pnpm --filter \"./plugins/*\" run testb",
    "build:all": "pnpm run build && pnpm run plugins:build",
    "test:all": "pnpm run test && pnpm run test:plugins"
  },
  "files": [
    "AGENTS.md",
    "builds/",
    "docs/",
    "llms.txt",
    "one/",
    "skills/",
    "src/",
    "three/",
    "tokenize/",
    "two/",
    "types/"
  ],
  "keywords": [
    "nlp"
  ],
  "dependencies": {
    "efrt": "catalog:",
    "grad-school": "0.0.8",
    "suffix-thumb": "6.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-terser": "catalog:",
    "@types/node": "catalog:",
    "cross-env": "catalog:",
    "eslint": "10.11.0",
    "eslint-plugin-regexp": "3.3.1",
    "nlp-corpus": "catalog:",
    "rollup": "catalog:",
    "rollup-plugin-filesize-check": "catalog:",
    "tap-dancer": "catalog:",
    "tape": "catalog:",
    "typescript": "7.0.2"
  },
  "unpkg": "./builds/compromise.js",
  "typesVersions": {
    "*": {
      "misc": [
        "types/misc.d.ts"
      ],
      "view/*": [
        "types/view/*.d.ts"
      ]
    }
  },
  "prettier": {
    "trailingComma": "es5",
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "arrowParens": "avoid"
  },
  "packageManager": "pnpm@11.5.0"
}
