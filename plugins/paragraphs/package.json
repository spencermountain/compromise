{
  "name": "compromise-paragraphs",
  "version": "0.1.0",
  "description": "Paragraph selection and manipulation for compromise",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spencermountain/compromise.git",
    "directory": "plugins/paragraphs"
  },
  "homepage": "https://github.com/spencermountain/compromise/tree/master/plugins/paragraphs",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./src/plugin.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./builds/compromise-paragraphs.cjs"
      }
    }
  },
  "main": "./builds/compromise-paragraphs.cjs",
  "module": "./builds/compromise-paragraphs.mjs",
  "types": "./index.d.ts",
  "sideEffects": false,
  "scripts": {
    "test": "tape \"./tests/**/*.test.js\" | tap-dancer --color always",
    "testb": "cross-env TESTENV=prod tape \"./tests/**/*.test.js\" | tap-dancer --color always",
    "watch": "node --watch ./scratch.js",
    "build": "rollup -c --silent"
  },
  "files": [
    "index.d.ts",
    "index.d.cts",
    "builds/",
    "src/"
  ],
  "devDependencies": {
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-terser": "catalog:",
    "rollup": "catalog:",
    "rollup-plugin-filesize-check": "catalog:",
    "tape": "catalog:",
    "cross-env": "catalog:",
    "tap-dancer": "catalog:"
  },
  "peerDependencies": {
    "compromise": "workspace:*"
  },
  "unpkg": "./builds/compromise-paragraphs.min.js"
}
