{
  "name": "compromise-unist",
  "version": "0.0.1",
  "description": "AST input support for compromise",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spencermountain/compromise.git",
    "directory": "plugins/unist"
  },
  "homepage": "https://github.com/spencermountain/compromise/tree/master/plugins/unist",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./src/plugin.js"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./builds/compromise-unist.cjs"
      }
    },
    "./markdown": {
      "import": "./src/markdown/plugin.js"
    },
    "./mdast": {
      "import": "./src/markdown/plugin.js"
    }
  },
  "main": "./builds/compromise-unist.cjs",
  "module": "./builds/compromise-unist.mjs",
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "tape \"./tests/**/*.test.js\" | tap-dancer --color always",
    "testb": "cross-env TESTENV=prod tape \"./tests/**/*.test.js\" | tap-dancer --color always",
    "watch": "node --watch ./scratch.js",
    "version": "node ./scripts/version.js",
    "build": "node ./scripts/version.js && rollup -c --silent"
  },
  "files": [
    "types/",
    "builds/",
    "src/"
  ],
  "devDependencies": {
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-terser": "catalog:",
    "cross-env": "catalog:",
    "rollup": "catalog:",
    "rollup-plugin-filesize-check": "catalog:",
    "tap-dancer": "catalog:",
    "tape": "catalog:"
  },
  "peerDependencies": {
    "compromise": "workspace:^"
  },
  "unpkg": "./builds/compromise-unist.min.js",
  "dependencies": {
    "mdast-util-from-markdown": "catalog:",
    "mdast-util-to-markdown": "catalog:"
  }
}
