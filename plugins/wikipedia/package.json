{
  "name": "compromise-wikipedia",
  "version": "0.1.1",
  "description": "Wikipedia title matching for compromise",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spencermountain/compromise.git",
    "directory": "plugins/wikipedia"
  },
  "homepage": "https://github.com/spencermountain/compromise/tree/master/plugins/wikipedia",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./src/plugin.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./builds/compromise-wikipedia.cjs"
      }
    }
  },
  "main": "./src/plugin.js",
  "types": "./index.d.ts",
  "sideEffects": false,
  "scripts": {
    "test": "tape \"./tests/**/*.test.js\" | tap-dancer --color always",
    "testb": "cross-env TESTENV=prod tape \"./tests/**/*.test.js\" | tap-dancer --color always",
    "watch": "node --watch ./scratch.js",
    "generate": "node ./scripts/generate/index.js",
    "stat": "node ./scripts/stat.js",
    "perf": "node ./scripts/perf.js",
    "build": "rollup -c --silent"
  },
  "files": [
    "index.d.ts",
    "index.d.cts",
    "builds/",
    "src/"
  ],
  "dependencies": {
    "efrt": "catalog:"
  },
  "devDependencies": {
    "colorette": "2.0.16",
    "node-wget-promise": "0.1.6",
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-terser": "catalog:",
    "rollup": "catalog:",
    "rollup-plugin-filesize-check": "catalog:",
    "tape": "catalog:",
    "cross-env": "catalog:",
    "tap-dancer": "catalog:"
  },
  "peerDependencies": {
    "compromise": "workspace:*"
  },
  "unpkg": "./builds/compromise-wikipedia.min.js"
}
